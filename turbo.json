{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "ai#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/tools/invoice-gen/**/*.py",
        "$TURBO_ROOT$/eval/**/*.py"
      ]
    },
    "ai#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/contracts/fixtures/**",
        "$TURBO_ROOT$/tools/invoice-gen/**/*.py",
        "$TURBO_ROOT$/tools/invoice-gen/templates/**",
        "$TURBO_ROOT$/tools/invoice-gen/fonts/**",
        "$TURBO_ROOT$/eval/runner/**/*.py",
        "$TURBO_ROOT$/eval/datasets/v1/**",
        "$TURBO_ROOT$/eval/baselines/**",
        "$TURBO_ROOT$/eval/reports/*.json"
      ],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    }
  }
}
