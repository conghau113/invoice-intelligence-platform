ENV=development
PORT=8000
LOG_LEVEL=info
# Shared secret between the API worker and this service (>= 16 chars). Generate: openssl rand -hex 24
AI_SERVICE_TOKEN=
# RAG evaluation judge (T5.6, eval only, never the product): its own OpenAI-compatible provider,
# apart from LLM_FALLBACK_*. See eval/rag/README.md. Synthetic data only.
RAG_JUDGE_BASE_URL=
RAG_JUDGE_API_KEY=
RAG_JUDGE_MODEL=qwen/qwen3.8-27b

# --- Fake provider rate limit (T6.2; only with LLM_PROVIDER=fake, never in production) ---
# Every Nth model call answers like a provider over its rate limit (429 with a wait), to watch the
# API queue slow down and recover (M6 demo, T6.7 drills). 0 = never.
FAKE_LLM_RATE_LIMIT_EVERY=0
# The wait it names, in seconds (1-300).
FAKE_LLM_RETRY_AFTER_S=2