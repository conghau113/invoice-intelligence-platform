# apps/web (Auth.js / BFF, ADR 0006). Copy to apps/web/.env.local
NEXTAUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/invoice
KEYCLOAK_CLIENT_ID=web
# Same value as WEB_CLIENT_SECRET in the root .env
KEYCLOAK_CLIENT_SECRET=