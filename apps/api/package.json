{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "NODE_ENV=development nest start --entryFile worker --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "jest",
    "build:deps": "pnpm --filter contracts --filter telemetry --filter logger build",
    "test:int": "pnpm build:deps && jest --config jest.int.config.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:build": "pnpm build:deps && tsc -p tsconfig.build.json --outDir dist-scripts --incremental false",
    "db:migrate": "pnpm db:build && node dist-scripts/db/migrate.js",
    "db:seed": "pnpm db:build && node dist-scripts/db/seed.js",
    "db:seed:documents": "pnpm db:build && node dist-scripts/db/seed-documents.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/websockets": "11.2.10",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "^6.3.17",
    "contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "logger": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "telemetry": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "notepack.io": "3.0.1",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.14",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
