# Runtime environment: development | test | production (required, no default)
NODE_ENV=development
# HTTP port (default 3001)
PORT=3001
# Public demo mode: no writes, no uploads, no LLM calls (default false)
DEMO_READ_ONLY=false
# Exact token issuer (`iss`) the API accepts (required). Keycloak derives it from the request host.
OIDC_ISSUER_URL=http://localhost:8080/realms/invoice
# Where to fetch signing keys (optional; default <OIDC_ISSUER_URL>/protocol/openid-connect/certs)
# OIDC_JWKS_URL=
# Required token audience (`aud`, default api)
OIDC_AUDIENCE=api
# Postgres as the NON-owner role invoice_app, so Row-Level Security applies (required).
# Host port 5433 = compose Postgres. The password is set by `db:migrate` from APP_DB_PASSWORD.
DATABASE_URL=postgres://invoice_app:invoice-app-dev-only@localhost:5433/invoice
# Used ONLY by `db:migrate` / `db:seed` (table owner). The API process never reads these two.
DATABASE_OWNER_URL=postgres://invoice:invoice-dev-only@localhost:5433/invoice
APP_DB_PASSWORD=invoice-app-dev-only

DATA_DIR= /home/conghau1103/code/invoice-intelligence-platform/data
REDIS_URL=redis://localhost:6380
# Internal AI service (T2.9). Base URL of apps/ai, and the shared bearer token the worker sends.
# Must equal AI_SERVICE_TOKEN of the AI service (at least 16 characters). Generate: openssl rand -hex 24
# `pnpm dev:api`, `pnpm dev:worker` and `pnpm dev:ai` fill in dev-only defaults when these are unset.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
TRUSTED_PROXIES=
EVAL_REPORTS_DIR=
RAG_TOP_K=5
RAG_CANDIDATES=20