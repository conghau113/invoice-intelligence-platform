# Runtime environment: development | test | production (required, no default)
NODE_ENV=development
# HTTP port (default 3001)
PORT=3001
# Public demo mode: no writes, no uploads, no LLM calls (default false)
DEMO_READ_ONLY=false
# Exact token issuer (`iss`) the API accepts (required). Keycloak derives it from the request host.
OIDC_ISSUER_URL=http://localhost:8080/realms/invoice
# Where to fetch signing keys (optional; default <OIDC_ISSUER_URL>/protocol/openid-connect/certs)
# OIDC_JWKS_URL=
# Required token audience (`aud`, default api)
OIDC_AUDIENCE=api
# Postgres as the NON-owner role invoice_app, so Row-Level Security applies (required).
# Host port 5433 = compose Postgres. The password is set by `db:migrate` from APP_DB_PASSWORD.
DATABASE_URL=postgres://invoice_app:invoice-app-dev-only@localhost:5433/invoice
# Used ONLY by `db:migrate` / `db:seed` (table owner). The API process never reads these two.
DATABASE_OWNER_URL=postgres://invoice:invoice-dev-only@localhost:5433/invoice
APP_DB_PASSWORD=invoice-app-dev-only

DATA_DIR= /home/conghau1103/code/invoice-intelligence-platform/data
REDIS_URL=redis://localhost:6380
# Internal AI service (T2.9). Base URL of apps/ai, and the shared bearer token the worker sends.
# Must equal AI_SERVICE_TOKEN of the AI service (at least 16 characters). Generate: openssl rand -hex 24
# `pnpm dev:api`, `pnpm dev:worker` and `pnpm dev:ai` fill in dev-only defaults when these are unset.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
TRUSTED_PROXIES=
EVAL_REPORTS_DIR=
RAG_TOP_K=5
RAG_CANDIDATES=20

# --- LLM provider limits (T6.2, docs/architecture/AI_PIPELINE.md §8) ---
# What the provider plan allows. Take the numbers from the provider's rate-limit page
# (AI Studio → Rate limit). The extraction queue starts at most min(RPM, TPM / 16000) jobs a minute.
# Gemini 3.5 Flash Lite free tier (read 2026-11-14): 15 RPM, 250K TPM, 500 RPD.
# Kept below that on purpose: Q&A uses the same model and is not paced by the queue.
LLM_RPM=10
LLM_TPM=100000
# The embedding model behind indexing has its own quota (Gemini Embedding free: 100 RPM, 30K TPM).
EMBED_RPM=60
EMBED_TPM=30000
# Length of the provider's "minute" in ms. Keep 60000; tests shrink it.
PROVIDER_MINUTE_MS=60000
# Circuit breaker of the queues: provider failures in a row (from that many different documents)
# that hold the queue, and the first pause in ms (doubled after each failed probe, up to 10 min).
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=60000
CACHE_ENABLED=true

# Realtime (T6.4). Socket.IO pushes document progress to the browser.
# HS256 key that signs the 60 s socket handshake token (aud=realtime). At least 32 characters.
# Unset or empty = realtime off: the web keeps polling (the public demo runs this way).
# `pnpm dev:api` / `pnpm dev:worker` / `pnpm dev:stack` set a dev-only value themselves.
# Generate one with: openssl rand -hex 32
REALTIME_TOKEN_SECRET=
# Browser origins allowed to open a socket, comma-separated, bare origins only (no path), never `*`.
# Defaults to http://localhost:3000 outside production; REQUIRED in production when the key is set.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# A socket is closed after this long (+ up to 10% jitter) so the client reconnects with a new token:
# a user signed out or removed from the tenant loses the stream within this time. 1000..3600000.
REALTIME_MAX_CONNECTION_MS=900000