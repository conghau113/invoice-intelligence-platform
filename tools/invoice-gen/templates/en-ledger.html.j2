{% extends "_base.html.j2" %}
{% block css %}
body { font: 13px/1.4 Tinos; }
h1 { font-size: 20px; margin: 0; letter-spacing: .12em; text-transform: uppercase; border-bottom: 3px double #000; padding-bottom: 5px; }
.head { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin: 10px 0 14px; }
.head h2 { font-size: 12.5px; margin: 0 0 2px; font-style: italic; font-weight: 400; }
.sums { width: 46%; margin-bottom: 12px; }
.sums td, .sums th { padding: 2px 4px; border-bottom: 1px solid #aaa; text-align: left; }
.sums .total td, .sums .total th { font-weight: 700; border-bottom: 3px double #000; }
.items th { border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 4px; text-align: left; }
.items td { padding: 3px 4px; vertical-align: top; }
.items tbody tr:nth-child(even) { background: #f3f3f0; }
{% endblock %}
{% block content %}
<h1>Commercial invoice</h1>
<section class="head">
  <div>
    <h2>Seller</h2>
    <div><b>{{ inv.seller.name }}</b></div>
    <div>{{ inv.seller.address }}</div>
    <div>Tax code <span class="nb">{{ inv.seller.taxCode }}</span></div>
  </div>
  <div>
    <h2>Buyer</h2>
    <div><b>{{ inv.buyer.name }}</b></div>
    <div>{{ inv.buyer.address }}</div>
    <div>Tax code <span class="nb">{{ inv.buyer.taxCode or "none" }}</span></div>
  </div>
  <div>
    <h2>Reference</h2>
    <div>Invoice <span class="nb">{{ inv.invoiceNo }}</span></div>
    <div>Series <span class="nb">{{ inv.series }}</span></div>
    <div>Issued {{ fmt.date_long(inv.issueDate) }}</div>
    <div>Amounts in {{ inv.currency }}</div>
  </div>
</section>
<table class="sums">
  <tbody>
    <tr><th scope="row">Net amount</th><td class="r nb">{{ fmt.money(inv.subtotal) }}</td></tr>
    {% for item in inv.vatBreakdown %}
    <tr><th scope="row">VAT at {{ fmt.rate(item.rate) }} on <span class="nb">{{ fmt.money(item.base) }}</span></th><td class="r nb">{{ fmt.money(item.amount) }}</td></tr>
    {% endfor %}
    <tr class="total"><th scope="row">Amount payable</th><td class="r nb">{{ fmt.money(inv.total) }} {{ inv.currency }}</td></tr>
  </tbody>
</table>
<table class="items">
  <thead>
    <tr>
      <th scope="col">Item</th><th scope="col">Description</th><th scope="col" class="r">Quantity</th><th scope="col">Unit</th>
      <th scope="col" class="r">Price</th><th scope="col" class="r">VAT</th><th scope="col" class="r">Line total</th>
    </tr>
  </thead>
  <tbody>
    {% for line in inv.lines %}
    <tr>
      <td>{{ loop.index }}</td><td>{{ line.description }}</td><td class="r">{{ fmt.quantity(line.quantity) }}</td><td>{{ line.unit }}</td>
      <td class="r nb">{{ fmt.money(line.unitPrice) }}</td><td class="r">{{ fmt.rate(line.vatRate) }}</td>
      <td class="r nb">{{ fmt.money(line.amount) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
