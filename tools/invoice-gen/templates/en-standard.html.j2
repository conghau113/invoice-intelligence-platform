{% extends "_base.html.j2" %}
{% block css %}
body { font: 12.5px/1.45 Arimo; }
.top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.from { max-width: 58%; }
h1 { font-size: 30px; letter-spacing: .04em; color: #2d5d4f; margin: 0; text-align: right; }
.meta { margin-top: 4px; text-align: right; }
.bill { border-left: 3px solid #2d5d4f; padding: 2px 0 2px 10px; margin-bottom: 14px; }
.label { font-size: 10.5px; color: #555; text-transform: uppercase; letter-spacing: .05em; }
.items th { border-bottom: 2px solid #2d5d4f; padding: 5px 6px; text-align: left; }
.items td { border-bottom: 1px solid #ddd; padding: 5px 6px; vertical-align: top; }
.lower { margin-top: 14px; display: flex; justify-content: flex-end; }
.lower table { width: 68%; }
.lower td, .lower th { padding: 3px 6px; }
.lower .total td, .lower .total th { border-top: 2px solid #2d5d4f; font-size: 15px; font-weight: 700; }
{% endblock %}
{% block content %}
<section class="top">
  <div class="from">
    <div class="label">From</div>
    <div><b>{{ inv.seller.name }}</b></div>
    <div>{{ inv.seller.address }}</div>
    <div>Tax ID: <span class="nb">{{ inv.seller.taxCode }}</span></div>
  </div>
  <div>
    <h1>INVOICE</h1>
    <div class="meta">
      <div>No. <span class="nb">{{ inv.invoiceNo }}</span></div>
      <div>Series <span class="nb">{{ inv.series }}</span></div>
      <div>Date: {{ fmt.date_long(inv.issueDate) }}</div>
      <div>Currency: {{ inv.currency }}</div>
    </div>
  </div>
</section>
<section class="bill">
  <div class="label">Bill to</div>
  <div><b>{{ inv.buyer.name }}</b></div>
  <div>{{ inv.buyer.address }}</div>
  <div>Tax ID: <span class="nb">{{ inv.buyer.taxCode or "not provided" }}</span></div>
</section>
<table class="items">
  <thead>
    <tr>
      <th scope="col">Description</th><th scope="col" class="r">Qty</th><th scope="col">Unit</th>
      <th scope="col" class="r">Unit price</th><th scope="col" class="r">Tax</th><th scope="col" class="r">Amount</th>
    </tr>
  </thead>
  <tbody>
    {% for line in inv.lines %}
    <tr>
      <td>{{ line.description }}</td><td class="r">{{ fmt.quantity(line.quantity) }}</td><td>{{ line.unit }}</td>
      <td class="r nb">{{ fmt.money(line.unitPrice) }}</td><td class="r">{{ fmt.rate(line.vatRate) }}</td>
      <td class="r nb">{{ fmt.money(line.amount) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="lower">
  <table>
    <tbody>
      <tr><th scope="row" style="text-align:left">Subtotal</th><td></td><td class="r nb">{{ fmt.money(inv.subtotal) }}</td></tr>
      {% for item in inv.vatBreakdown %}
      <tr><th scope="row" style="text-align:left">VAT {{ fmt.rate(item.rate) }}</th><td class="r nb">on {{ fmt.money(item.base) }}</td><td class="r nb">{{ fmt.money(item.amount) }}</td></tr>
      {% endfor %}
      <tr class="total"><th scope="row" style="text-align:left">Total due</th><td></td><td class="r nb">{{ fmt.money(inv.total) }} {{ inv.currency }}</td></tr>
    </tbody>
  </table>
</div>
{% endblock %}
